APP_NAME="مشتری‌یار"
APP_ENV=production

# ---- برند (شخصی‌سازی) ----
BRAND_NAME="مشتری‌یار"
BRAND_NAME_EN="MoshtariYar"
BRAND_TAGLINE="مدیریت هوشمند مشتریان، فروش و وفاداری"
BRAND_OWNER="هومن‌وب"
BRAND_OWNER_EN="HoomanWeb"
BRAND_DOMAIN="hoomanweb.ir"
BRAND_URL="https://hoomanweb.ir"
BRAND_SUPPORT_EMAIL="support@hoomanweb.ir"
BRAND_SUPPORT_PHONE=""

APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://your-domain.com
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# ═══════════════════════════════════════════
# ⚡ کش، صف و نشست — دو حالت قابل تنظیم
# ═══════════════════════════════════════════
#
# ── حالت ۱: دیتابیس (پیش‌فرض — بدون نیاز به هیچ نرم‌افزار اضافه) ──
#   مناسب برای: هاست اشتراکی، cPanel معمولی، سایت‌های کم‌تا-متوسط
#
# ── حالت ۲: Redis (پیشنهادی برای ترافیک بالا — ۱۰۰۰+ کاربر همزمان) ──
#   نیازمند: نصب Redis روی هاست (از بخش «انتخاب نسخهٔ PHP» در cPanel)
#   برای فعال‌سازی: فقط ۳ متغیر زیر را به redis تغییر دهید
#
#   QUEUE_CONNECTION=redis
#   CACHE_STORE=redis
#   SESSION_DRIVER=redis
#
# ═══════════════════════════════════════════

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ---- Redis (در صورت موجود بودن روی هاست) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ---- کش مرورگر و فشرده‌سازی ----
CACHE_PREFIX=crm_cache

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- دیتابیس (از بخش MySQL Databases در cPanel بسازید) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ---- ایمیل (اختیاری) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============ درگاه‌های پرداخت ============
PAYMENT_DEFAULT=zarinpal

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

ZIBAL_MERCHANT=

# ============ پنل‌های پیامک ============
SMS_DEFAULT=smsir

SMSIR_API_KEY=
SMSIR_LINE_NUMBER=

MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ============ سامانه مودیان (مالیات) ============
VAT_RATE=0.10
MOADIAN_MEMORY_ID=
MOADIAN_PRIVATE_KEY_PATH=
MOADIAN_BASE_URL=https://tp.tax.gov.ir